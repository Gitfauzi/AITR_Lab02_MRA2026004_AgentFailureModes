{\n  \"cells\": [\n    {\n      \"cell_type\": \"markdown\",\n      \"metadata\": {},\n      \"source\": [\n        \"# Analysis Notebook — Lab Assignment 02\\n\",\n        \"## Failure Modes in Chained Tool-Calling Agents\\n\",\n        \"### MRA2026004 | IIIT Allahabad\\n\",\n        \"\\n\",\n        \"This notebook loads the simulation results and reproduces the key figures and statistics reported in the paper.\"\n      ]\n    },\n    {\n      \"cell_type\": \"code\",\n      \"execution_count\": null,\n      \"metadata\": {},\n      \"outputs\": [],\n      \"source\": [\n        \"import csv\\n\",\n        \"import math\\n\",\n        \"\\n\",\n        \"results = []\\n\",\n        \"with open('../results/trajectory_metrics.csv', newline='') as f:\\n\",\n        \"    reader = csv.DictReader(f)\\n\",\n        \"    for row in reader:\\n\",\n        \"        results.append({\\n\",\n        \"            'chain_length': int(row['chain_length']),\\n\",\n        \"            'mode': row['mode'],\\n\",\n        \"            'task_success_rate': float(row['task_success_rate']),\\n\",\n        \"            'divergence_rate': float(row['divergence_rate']),\\n\",\n        \"            'avg_irreversible_errors': float(row['avg_irreversible_errors']),\\n\",\n        \"            'avg_human_interventions': float(row['avg_human_interventions'])\\n\",\n        \"        })\\n\",\n        \"\\n\",\n        \"print(f'Loaded {len(results)} result rows')\\n\",\n        \"print('Columns:', list(results[0].keys()))\"\n      ]\n    },\n    {\n      \"cell_type\": \"code\",\n      \"execution_count\": null,\n      \"metadata\": {},\n      \"outputs\": [],\n      \"source\": [\n        \"print(f\"{'n':>6} | {'Mode':>10} | {'Success':>10} | {'Divergence':>12} | {'Irrev. Err':>12} | {'Interventions':>14}\")\\n\",\n        \"print('-' * 72)\\n\",\n        \"for r in results:\\n\",\n        \"    print(f\"{r['chain_length']:^6} | {r['mode']:<10} | {r['task_success_rate']*100:>9.1f}% | {r['divergence_rate']*100:>11.1f}% | {r['avg_irreversible_errors']:>12.3f} | {r['avg_human_interventions']:>14.2f}\")\"\n      ]\n    },\n    {\n      \"cell_type\": \"code\",\n      \"execution_count\": null,\n      \"metadata\": {},\n      \"outputs\": [],\n      \"source\": [\n        \"none_data = {r['chain_length']: r for r in results if r['mode'] == 'none'}\\n\",\n        \"adaptive_data = {r['chain_length']: r for r in results if r['mode'] == 'adaptive'}\\n\",\n        \"\\n\",\n        \"print('Adaptive vs Unsupervised — Irreversible Error Reduction:')\\n\",\n        \"print(f\"{'n':>6} | {'None Err':>10} | {'Adapt Err':>10} | {'Reduction':>12}\")\\n\",\n        \"print('-' * 48)\\n\",\n        \"for n in sorted(none_data.keys()):\\n\",\n        \"    none_err = none_data[n]['avg_irreversible_errors']\\n\",\n        \"    adapt_err = adaptive_data[n]['avg_irreversible_errors']\\n\",\n        \"    reduction = (1 - adapt_err / none_err) * 100 if none_err > 0 else 0\\n\",\n        \"    print(f\"{n:>6} | {none_err:>10.3f} | {adapt_err:>10.3f} | {reduction:>11.1f}%\")\"\n      ]\n    },\n    {\n      \"cell_type\": \"code\",\n      \"execution_count\": null,\n      \"metadata\": {},\n      \"outputs\": [],\n      \"source\": [\n        \"p_base = 0.95\\n\",\n        \"n = 50\\n\",\n        \"theoretical_independent = p_base ** n\\n\",\n        \"empirical_unsupervised = 0.085  # from results\\n\",\n        \"\\n\",\n        \"print(f\"Theoretical (independent, p=0.95, n=50): {theoretical_independent*100:.2f}%\")\\n\",\n        \"print(f\"Empirical unsupervised (autocorrelated): {empirical_unsupervised*100:.1f}%\")\\n\",\n        \"print(f\"WebArena GPT-4 empirical:                14.41%\")\\n\",\n        \"print(f\"Adaptive checkpointing (proposed):        79.0%\")\\n\",\n        \"print()\\n\",\n        \"print(f\"=> Autocorrelation degrades success by {(theoretical_independent - empirical_unsupervised)*100:.1f} percentage points beyond i.i.d. floor\")\"\n      ]\n    },\n    {\n      \"cell_type\": \"code\",\n      \"execution_count\": null,\n      \"metadata\": {},\n      \"outputs\": [],\n      \"source\": [\n        \"none_success = {r['chain_length']: r['task_success_rate'] for r in results if r['mode'] == 'none'}\\n\",\n        \"fixed_success = {r['chain_length']: r['task_success_rate'] for r in results if r['mode'] == 'fixed_5'}\\n\",\n        \"adaptive_success = {r['chain_length']: r['task_success_rate'] for r in results if r['mode'] == 'adaptive'}\\n\",\n        \"\\n\",\n        \"print('Task Success Rate vs Chain Length')\\n\",\n        \"print(f\"{'n':>4} | {'None':>8} | {'Fixed-5':>8} | {'Adaptive':>10}\")\\n\",\n        \"print('-' * 40)\\n\",\n        \"for n in sorted(none_success.keys()):\\n\",\n        \"    bar_none = '#' * int(none_success[n] * 20)\\n\",\n        \"    print(f\"{n:>4} | {none_success[n]*100:>7.1f}% | {fixed_success[n]*100:>7.1f}% | {adaptive_success[n]*100:>9.1f}%  {bar_none}\")\"\n      ]\n    }\n  ],\n  \"metadata\": {\n    \"kernelspec\": {\n      \"display_name\": \"Python 3\",\n      \"language\": \"python\",\n      \"name\": \"python3\"\n    },\n    \"language_info\": {\n      \"name\": \"python\",\n      \"version\": \"3.14.0\"\n    }\n  },\n  \"nbformat\": 4,\n  \"nbformat_minor\": 4\n}